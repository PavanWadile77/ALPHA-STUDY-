rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function isAdmin() {
   return signedIn() && request.auth.uid in ['fMGIdEIX9YcpqTYS9LswRMcFSIb2','jIf44hCNk6heym0SI0dGRUhIs7G2'];
  }
  function validGroup(d) {
   return (d.yearId == 'year-1' && d.groupId in ['group-a','group-b'])
    || (d.yearId in ['year-2','year-3','year-4'] && d.groupId in ['cse','it','ds','ecs']);
  }
  function validMaterial(d) {
   return d.keys().hasAll(['title','description','yearId','groupId','semester','subject','type','unit','originalFileName','storagePath','downloadURL','contentType','sizeBytes','uploadedBy','uploaderEmail','createdAt','published'])
    && d.keys().hasOnly(['title','description','yearId','groupId','semester','subject','type','unit','originalFileName','storagePath','downloadURL','contentType','sizeBytes','uploadedBy','uploaderEmail','createdAt','published','updatedBy','updatedAt'])
    && d.title is string && d.title.size() > 0 && d.title.size() <= 500
    && d.description is string && d.description.size() <= 5000
    && d.subject is string && d.subject.size() > 0 && d.subject.size() <= 200
    && validGroup(d)
    && ((d.yearId == 'year-1' && d.semester in ['sem-1','sem-2'])
     || (d.yearId == 'year-2' && d.semester in ['sem-3','sem-4'])
     || (d.yearId == 'year-3' && d.semester in ['sem-5','sem-6'])
     || (d.yearId == 'year-4' && d.semester in ['sem-7','sem-8']))
    && d.type in ['Lecture Notes','Question Paper (PYQ)','Question Bank','Lab Manual','Syllabus Scheme','Reference Book','Other']
    && d.unit is string && d.unit.size() <= 100
    && d.originalFileName is string && d.originalFileName.size() <= 255
    && d.sizeBytes is int && d.sizeBytes > 0 && d.sizeBytes <= 25 * 1024 * 1024
    && d.contentType in ['application/pdf','application/msword','application/vnd.openxmlformats-officedocument.wordprocessingml.document','application/vnd.ms-powerpoint','application/vnd.openxmlformats-officedocument.presentationml.presentation','application/zip','text/plain']
    && d.storagePath is string && d.storagePath.matches('materials/' + d.yearId + '/' + d.groupId + '/[^/]+')
    && d.downloadURL is string && (d.downloadURL.matches('https://firebasestorage[.]googleapis[.]com/v0/b/alpha-c3c01[.]firebasestorage[.]app/o/materials%2F.*')
     || d.downloadURL == 'https://rjeqphxewhbinkidspdm.supabase.co/storage/v1/object/authenticated/study-materials/' + d.storagePath)
    && d.published is bool && d.createdAt is timestamp;
  }
  match /admins/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow write: if false;
  }
  match /materials/{id} {
   allow read: if isAdmin() || (signedIn() && resource.data.published == true);
   allow create: if isAdmin() && validMaterial(request.resource.data)
    && request.resource.data.uploadedBy == request.auth.uid
    && request.resource.data.uploaderEmail == request.auth.token.email
    && request.resource.data.createdAt == request.time
    && !request.resource.data.keys().hasAny(['updatedBy','updatedAt']);
   allow update: if isAdmin() && validMaterial(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','subject','updatedBy','updatedAt'])
    && request.resource.data.updatedBy == request.auth.uid
    && request.resource.data.updatedAt == request.time;
   allow delete: if isAdmin();
  }
  match /users/{uid} {
   allow read: if signedIn() && request.auth.uid == uid;
   allow create, update: if signedIn() && request.auth.uid == uid
    && request.resource.data.keys().hasOnly(['name','displayName','email','photoURL','createdAt','updatedAt']);
   allow delete: if signedIn() && request.auth.uid == uid;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
